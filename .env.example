# --- Telegram (obrigatório) ---
TELEGRAM_BOT_TOKEN=123456:ABC...      # crie com o @BotFather
TELEGRAM_CHAT_ID=123456789            # veja o README

# --- Modelo: formato "provedor:modelo" (Pydantic AI). Escolha UM bloco. ---
# Claude (padrão):
LLM_MODEL=anthropic:claude-haiku-4-5
ANTHROPIC_API_KEY=sk-ant-...
# Haiku 5.5 (mais barato; NÃO testado neste projeto):  LLM_MODEL=anthropic:claude-haiku-5-5
#
# Groq (grátis, limites baixos):   LLM_MODEL=groq:qwen/qwen3.8-27b      GROQ_API_KEY=gsk_...
# DeepSeek:                        LLM_MODEL=deepseek:deepseek-flash   DEEPSEEK_API_KEY=sk-...   LLM_THINKING=off  (off ≈ US$ 1/mês; se a qualidade cair, apague a linha LLM_THINKING para ligar o raciocínio, ≈ US$ 2/mês)
# Together / Fireworks / OpenRouter / Cerebras: LLM_MODEL=together:<modelo> (TOGETHER_API_KEY, etc.)
#
# Qualquer API compatível com OpenAI (ex.: Synthetic, DeepInfra, Moonshot/Kimi): use estas duas linhas
#LLM_BASE_URL=https://api.synthetic.new/openai/v1
#LLM_API_KEY=...
#LLM_MODEL=openai:hf:moonshotai/Kimi-K2.5      # só o que vem depois de ":" é usado como nome do modelo

# Cadastro de outras pessoas: quem mandar /start <INVITE_CODE> ao bot passa a receber os alertas. Sem isso, só você.
#INVITE_CODE=troque-por-uma-frase-longa-e-secreta
